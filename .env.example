

# --- PostgreSQL (superusuario del contenedor) ---
POSTGRES_DB=agenda
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar

# --- Roles de la base (los crea docker/postgres/init/01-roles.sh) ---
DB_URL=jdbc:postgresql://postgres:5432/agenda
DB_APP_USER=app_rw
DB_APP_PASSWORD=cambiar
DB_OWNER_USER=app_owner
DB_OWNER_PASSWORD=cambiar

# --- Autenticación (se usan desde C-04) ---
# Generar con: openssl rand -base64 48
JWT_SECRET=cambiar-por-un-secreto-de-al-menos-32-bytes
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P14D

# --- Frontend / CORS ---
APP_FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=/api/v1

# --- Correo (Mailpit en local; se usa desde C-05) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-responder@localhost

# --- Perfil de Spring ---
SPRING_PROFILES_ACTIVE=local