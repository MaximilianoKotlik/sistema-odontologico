{
  "name": "sistema-odontologico-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:types": "node scripts/api-types.mjs",
    "seguridad:revisar": "node --experimental-strip-types --no-warnings scripts/seguridad-revisar.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "autoprefixer": "10.7.0",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "jsdom": "27.4.0",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.33",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "7.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "4.1.12"
  }
}
